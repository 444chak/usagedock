<Application x:Class="UsageDock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:UsageDock.Ui"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ui:PercentToWidthConverter x:Key="PercentToWidth" />
            <ui:BoolToVisibilityConverter x:Key="BoolToVisibility" />

            <SolidColorBrush x:Key="DockBackground" Color="#F2181A20" />
            <SolidColorBrush x:Key="CardBackground" Color="#FA1B1E26" />
            <SolidColorBrush x:Key="BorderSubtle" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="TextPrimary" Color="#F2F4F8" />
            <SolidColorBrush x:Key="TextSecondary" Color="#98A0AE" />
            <SolidColorBrush x:Key="RingTrack" Color="#33FFFFFF" />

            <Style x:Key="LabelText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>

            <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
