<Window x:Class="UsageDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UsageDock"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Topmost="True"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Background="{StaticResource DockBackground}"
        Width="46" Height="120"
        SizeToContent="Manual"
        WindowStartupLocation="Manual">

    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10">
        <StackPanel x:Name="ProviderStack" Orientation="Vertical" Margin="0,5" />
    </Border>
</Window>
