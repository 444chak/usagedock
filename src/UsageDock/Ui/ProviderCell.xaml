<UserControl x:Class="UsageDock.Ui.ProviderCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:UsageDock.Ui"
             Width="56" Height="72"
             Focusable="False"
             Background="Transparent"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,5,0,0">
            <ui:UsageRing x:Name="Ring"
                          Width="42" Height="42"
                          StrokeThickness="3.2"
                          SecondaryStrokeThickness="2.5"
                          Percent="{Binding Percent}"
                          SecondaryPercent="{Binding LongPercent}"
                          HasSecondary="{Binding HasLongWindow}"
                          Dimmed="{Binding Dimmed}"
                          Glyph="{Binding Glyph}"
                          GlyphBrush="{Binding BrandBrush}"
                          ProgressBrush="{Binding RingBrush}"
                          SecondaryBrush="{Binding LongRingBrush}"
                          TrackBrush="{StaticResource RingTrack}" />

            <Ellipse Width="8" Height="8"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,0,4,0"
                     Fill="{Binding ActivityBrush}" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{Binding PercentText}"
                   Foreground="{Binding PercentBrush}"
                   FontFamily="Segoe UI"
                   FontSize="11"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,3,0,0"
                   TextOptions.TextFormattingMode="Display" />
    </Grid>
</UserControl>
