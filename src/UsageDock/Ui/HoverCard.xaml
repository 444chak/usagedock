<Window x:Class="UsageDock.Ui.HoverCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UsageDock details"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Topmost="True"
        Focusable="False"
        ShowActivated="False"
        IsHitTestVisible="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        SizeToContent="Manual"
        Background="{StaticResource CardBackground}"
        WindowStartupLocation="Manual">

    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="12,10">
        <StackPanel>
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Name}"
                           Foreground="{StaticResource TextPrimary}"
                           FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                           TextOptions.TextFormattingMode="Display" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding PlanText}"
                           Style="{StaticResource LabelText}"
                           VerticalAlignment="Center" />
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding ActivityBrush}" />
                <TextBlock Text="{Binding ActivityText}" Style="{StaticResource ValueText}" Margin="6,0,0,0" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,9">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Style="{StaticResource ValueText}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ResetText}" Style="{StaticResource LabelText}" />
                            </DockPanel>

                            <Border Height="5" Width="222" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource RingTrack}" Margin="0,4,0,0">
                                <Border HorizontalAlignment="Left"
                                        CornerRadius="3"
                                        Background="{StaticResource TextPrimary}"
                                        Width="{Binding Percent, Converter={StaticResource PercentToWidth}}" />
                            </Border>

                            <DockPanel LastChildFill="False" Margin="0,3,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding UsedText}" Style="{StaticResource LabelText}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding LeftText}" Style="{StaticResource LabelText}" />
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource LabelText}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" />

            <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,2,0,6" />

            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Updated" Style="{StaticResource LabelText}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding UpdatedText}" Style="{StaticResource LabelText}" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
