<?xml version="1.0" encoding="UTF-8"?>
<!--
  Per-user MSI for UsageDock.

  Installs to %LOCALAPPDATA%\Programs\UsageDock, needs no admin rights and no UAC prompt, and
  can be removed from Settings > Apps. The payload is the self-contained publish folder, so the
  .NET runtime is bundled and nothing has to be installed first.

  Deliberately not single-file and not compressed: single-file compression halves the download
  but decompresses assemblies into memory, and for a widget that sits on screen all day the
  resident memory matters more than the disk footprint. The MSI cab compresses the folder anyway.

  The install folder is stable on purpose. The Claude Code hooks store an absolute path to the
  executable, so an app that moves breaks them; one that always installs to the same place does
  not.

  The UI is deliberately short: no welcome page and no licence page, since there is nothing to
  choose. Double clicking the MSI goes straight to the progress bar and ends on a page that says
  it worked, with the app ticked to start. Without that last page the installer finished in
  silence and looked as if it had done nothing.

  Build with installer\build.ps1, which publishes the app and passes PublishDir and Version in.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="UsageDock"
           Manufacturer="444chak"
           Version="$(Version)"
           UpgradeCode="7f0c2a4e-6b1d-4c3a-9e58-1d2f8a6b3c90"
           Scope="perUser"
           Language="1033"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of UsageDock is already installed."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- A running copy holds its own files open; ask it to quit before touching them. -->
    <util:CloseApplication Id="CloseRunningDock"
                           Target="UsageDock.exe"
                           CloseMessage="yes"
                           TerminateProcess="0"
                           Timeout="10"
                           RebootPrompt="no" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="UsageDock" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="Application" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**" />
    </ComponentGroup>

    <!--
      Per-user components that live in the profile must key on a registry value, not a file.
      This value is also what Settings > Apps uses to know the product is present.
    -->
    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="StartMenuEntry"
                Name="UsageDock"
                Description="Claude and Codex quota dock"
                Target="[INSTALLFOLDER]UsageDock.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU"
                     Key="Software\UsageDock"
                     Name="InstallFolder"
                     Type="string"
                     Value="[INSTALLFOLDER]"
                     KeyPath="yes" />
    </Component>

    <!-- Nothing to modify or repair in place; reinstalling the MSI does the same job. -->
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch UsageDock" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <!--
      Started through the shell, as the user, after the installer is done with the files. An
      upgrade closes the running copy first (CloseRunningDock), so this brings it back.
    -->
    <SetProperty Id="WixShellExecTarget" Value="[INSTALLFOLDER]UsageDock.exe"
                 After="CostFinalize" Sequence="ui" />
    <CustomAction Id="LaunchApplication"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />

    <UI Id="UsageDockUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT REMOVE" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>

    <UIRef Id="WixUI_Common" />

    <Feature Id="Main" Title="UsageDock" Level="1">
      <ComponentGroupRef Id="Application" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

  </Package>
</Wix>
